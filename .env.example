# Copy to .env.local and fill in. Never commit real values.

# Public address of the deployed app (the bot opens APP_URL/app as the mini app)
APP_URL=

# Telegram bot from @BotFather
TELEGRAM_BOT_TOKEN=
# Random string; Telegram sends it back in the X-Telegram-Bot-Api-Secret-Token header
TELEGRAM_WEBHOOK_SECRET=

# AI assistant (Anthropic API)
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-5-5
# Optional: a gateway with the Anthropic Messages API, e.g. https://openrouter.ai/api
# (then ANTHROPIC_API_KEY is the gateway's key and ASSISTANT_MODEL=anthropic/claude-haiku-5.5)
ASSISTANT_BASE_URL=
ASSISTANT_MESSAGES_PER_DAY=20
ASSISTANT_DAILY_BUDGET_USD=2

# Postgres
DATABASE_URL=

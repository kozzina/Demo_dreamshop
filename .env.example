# Copy to .env.local and fill in. Never commit real values.

# Telegram bot from @BotFather
TELEGRAM_BOT_TOKEN=
# Random string; Telegram sends it back in the X-Telegram-Bot-Api-Secret-Token header
TELEGRAM_WEBHOOK_SECRET=

# AI assistant through OpenRouter
OPENROUTER_API_KEY=
ASSISTANT_MODEL=anthropic/claude-haiku-5.5
ASSISTANT_FALLBACK_MODEL=z-ai/glm-5.3-flash
ASSISTANT_MESSAGES_PER_DAY=20
ASSISTANT_DAILY_BUDGET_USD=2

# Postgres
DATABASE_URL=
